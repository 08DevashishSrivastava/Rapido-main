# Server Configuration
PORT=4000
NODE_ENV=development

# Database Connection (MongoDB URI)
DB_CONNECT=mongodb://127.0.0.1:27017/ridepass_pro

# Security
JWT_SECRET=ridepass_pro_default_jwt_secret

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Razorpay Payment Gateway Configuration (Standard Checkout)
# Sign up at https://dashboard.razorpay.com and generate Test Keys in Settings > API Keys
RAZORPAY_KEY_ID=your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret

# Optional fallback payment provider
PAYMENT_PROVIDER=razorpay
