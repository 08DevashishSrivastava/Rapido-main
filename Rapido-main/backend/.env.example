# Server Configuration
PORT=4000
NODE_ENV=development

# Database Connection (MongoDB URI)
DB_CONNECT=mongodb://127.0.0.1:27017/ridepass_pro

# Security
JWT_SECRET=ridepass_pro_default_jwt_secret

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Razorpay Payment Gateway Configuration (Standard Checkout)
# Sign up at https://dashboard.razorpay.com and generate Test Keys in Settings > API Keys
RAZORPAY_KEY_ID=your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret

# Optional fallback payment provider
PAYMENT_PROVIDER=razorpay

# OTP Verification Provider Settings
# In development (NODE_ENV=development), OTP codes are delivered to server console and test payloads.
# Optional production SMTP or SMS provider variables:
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@your-domain.com
# SMTP_PASS=your_smtp_password
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
